// .qc file version 1.0
// generated by auto QC exporter v0.9
// file generated 6/6/00 10:56:21 AM
//

$modelname Combot.mdl
$eyeposition 0 0 1

//
// Tail controller
//
$controller 0 "Dummy (Root)"  ZR 0 360
$controller 1 "Dummy (Inner Wheel Pivot)" ZR 0 30
$controller 2 "Dummy (Tail Gun)" ZR 0 -118

$body "body" "Combot"

//
// Attachment points.
//
// 0 - Light
// 1 - Eye
// 2 - Left prong
// 3 - Right prong
//
$attachment 0 "dummy (root)" -8 15 0
$attachment 1 "dummy (root)" -16 2 0
$attachment 2 "dummy (root)" -26 2 6.25
$attachment 2 "dummy (root)" -26 2 -6.25

//
// Animation sequences.
//
// Nodes:
//   1 - Plates closed, prongs retracted (passive)
//   2 - Plates open, prongs retracted (alert)
//   3 - Plates open, prongs extended (combat)
//


$sequence Inspect01 "Combot_Inspect" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1
$sequence Inspect02 "Combot_Inspect2" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1
$sequence Inspect03 "Combot_Inspect3" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1
$sequence Inspect04 "Combot_Inspect4" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1
$sequence Inspect05 "Combot_Inspect5" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1
$sequence Inspect06 "Combot_Inspect6" loop FPS 30 activity ACT_SCANNER_INSPECT 1 Node 1

// Walks.
$sequence Walk "Combot_Walk" loop FPS 30 activity ACT_WALK 1 Node 1
$sequence Walk_Alert "Combot_Walk_Alert" loop FPS 30 activity ACT_SCANNER_WALK_ALERT 1 
$sequence Walk_Combat "Combot_Walk_Combat" loop FPS 30 activity ACT_SCANNER_WALK_COMBAT 1 

// Flinches.
$sequence SmallFlinch1 "Combot_Flinch" FPS 45 snap activity ACT_SMALL_FLINCH 1 Node 1
$sequence SmallFlinch2 "Combot_Flinch2" FPS 45 snap activity ACT_SMALL_FLINCH 1 Node 1
$sequence SmallFlinch3 "Combot_Flinch3" FPS 45 snap activity ACT_SMALL_FLINCH 1 Node 1

$sequence SmallFlinch_Alert1 "Combot_Flinch_Alert" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_ALERT 1 Node 2
$sequence SmallFlinch_Alert2 "Combot_Flinch_Alert2" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_ALERT 1 Node 2
//$sequence SmallFlinch_Alert3 "Combot_Flinch_Alert3" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_ALERT 1 Node 2

$sequence SmallFlinch_Combat1 "Combot_Flinch_Combat" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_COMBAT 1 Node 3
$sequence SmallFlinch_Combat2 "Combot_Flinch_Combat2" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_COMBAT 1 Node 3
$sequence SmallFlinch_Combat3 "Combot_Flinch_Combat3" FPS 45 snap activity ACT_SCANNER_SMALL_FLINCH_COMBAT 1 Node 3

// Idles and state indicators.
$sequence Idle "Combot_Hover" loop FPS 30 activity ACT_IDLE 1 Node 1

// Photograph
$sequence Flare "Combot_Flare" FPS 30							ACT_SCANNER_FLARE 1			transition 1 2
$sequence Idle_Alert "Combot_Hover_Alert" FPS 30				ACT_SCANNER_IDLE_ALERT 1	Node 2 { event 1 0 } 
$sequence Retract "Combot_Flare_Retract" FPS 30					ACT_SCANNER_RETRACT 1		transition 2 1

// Attack
$sequence Flare_Prongs "Combot_Flare_Prongs" FPS 30				ACT_SCANNER_FLARE_PRONGS 1	transition 1 3
$sequence Idle_Combat "Combot_Hover_Combat"  loop FPS 30		ACT_IDLE_ANGRY 1 Node 3	
$sequence Retract_Prongs "Combot_Flare_Prongs_Retract" FPS 30	ACT_SCANNER_RETRACT_PRONGS 1 transition 3 1

$surfaceprop "metal"


// physics
$collisionmodel "Combot.VRM" {
	// Mass in kilograms
	$mass 15.0
}

