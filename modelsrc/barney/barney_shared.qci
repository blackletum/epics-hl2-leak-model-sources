$sequence "SWI_Whole" {
	"barney_anims\SWI_Whole.smd"
	{ event 3015 30 }
	{ event 2042 139 "attackoffcenter" }
	{ event 2042 141 "attackoffcenter" }
	{ event 2042 143 "attackoffcenter" }
	{ event 2042 148 "attackoffcenter" }
	{ event 2042 150 "attackoffcenter" }
	{ event 2042 152 "attackoffcenter" }
	{ event 2042 154 "attackoffcenter" }
	{ event 2042 173 "attackoffcenter" }
	{ event 2042 182 "attackoffcenter" }
	{ event 2042 196 "attackoffcenter" }
	{ event 2042 198 "attackoffcenter" }
	{ event 2042 212 "attackoffcenter" }
	{ event 2042 224 "attackoffcenter" }


	
