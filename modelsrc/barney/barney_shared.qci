$sequence "hand_posture_delta" {
	"a_hand_posture01"
	"a_hand_posture02"
	"a_hand_posture03"
	"a_hand_posture04"
	"a_hand_posture05"
	"a_hand_posture06"
	blend "arm_height" -1 1
	blend "arm_width" 0 1
	blendwidth 3
	delta


}