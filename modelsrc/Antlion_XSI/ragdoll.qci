$collisionjoints ragdoll {

	$mass 115.0
	$inertia 10.00
	$damping 0.01
	$rotdamping 1.50
	$rootbone "antlion.body_bone"

	
	$jointconstrain "antlion.wingl_bone" y limit -55.00 0.00 3.00
	$jointconstrain "antlion.wingl_bone" z limit -75.00 68.00 3.00

	$jointconstrain "antlion.wingr_bone" y limit  0.00 55.00 3.00
