	$jointconstrain "antlion.legmidr2_bone" z limit -97.00 41.00 1.00

	$jointconstrain "antlion.legmidr3_bone" x limit 0.00 0.00 1.00
	$jointconstrain "antlion.legmidr3_bone" y limit 0.00 0.00 0.00
	$jointconstrain "antlion.legmidr3_bone" z limit -41.00 100.00 1.00

