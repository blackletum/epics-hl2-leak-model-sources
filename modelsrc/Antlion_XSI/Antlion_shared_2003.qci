	{ event AE_CL_PLAYSOUND 15 "NPC_Antlion.JumpTouch" } 
	//{ event AE_CL_PLAYSOUND 37 "NPC_Antlion.JumpTouch" } 
}

$sequence antlion_soldier_DI_02 "soldierattack02.smd" fps 30 {
	walkframe 20 lx ly
	walkframe 60 lx ly
	//walkframe 99 lx ly
	{ event AE_CL_PLAYSOUND 1 "NPC_Antlion.MeleeAttackSingle" } 
	{ event AE_CL_PLAYSOUND 19 "NPC_Antlion.RunOverByVehicle" } 
	//{ event AE_CL_PLAYSOUND 37 "NPC_Antlion.JumpTouch" } 
}

$sequence alyx_antlion_fight1 "attack_01.smd" fps 30
$sequence alyx_antlion_fight2 "alyx_antlion_fight2.smd" fps 30

$sequence antlion_fallbkattack "antlion_fallbkattack" fps 30 


// VORT ANTLION INTERACTION

