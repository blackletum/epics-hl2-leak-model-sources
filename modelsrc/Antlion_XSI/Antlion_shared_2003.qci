//Bonus animations found in modelsrc

$sequence bugbait01 bugbait01 alignto idle
$sequence bugbaitrun01 bugbaitrun01 LX loop
$sequence charge01 charge01 lx
$sequence charge02 charge02 lx
$sequence creep01 creep01 lx loop
$sequence walk01 walk01 LX loop
$sequence sneakwalk01 sneakwalk01 LX loop
$sequence run01 run01 LX loop
$sequence run02 run02 LX loop
$sequence runattack01 runattack01 alignto run01 lx
$sequence flinch01 flinch01
$sequence flinchidle flinchidle
$sequence flinchin flinchin
$sequence flinchout flinchout
$sequence flinchscud flinchscud lx
$sequence flyattack01all flyattack01all lx
$sequence flyattack02all flyattack02all lx
$sequence flyattackidle flyattackidle
$sequence flyattackidle02 flyattackidle02
$sequence flyattackin01 flyattackin01 alignto idle LX LZ
$sequence flyattackin02 flyattackin02 alignto idle LX LZ
$sequence flyattackout flyattackout alignto idle LX //LZ 
$sequence flyattackout02 flyattackout02 alignto idle LX //LZ
