$sequence digidle		"digin01"			loop frame 99 100 FPS 30 activity ACT_ANTLION_BURROW_IDLE 1

//Special Attacks
$sequence touchtest		"touchtest"	{
	walkframe 32
}
	
$sequence frustration	"frustattack01" activity ACT_ANTLION_FRUSTRATION1 1

/*

//Head Turn
$weightlist head_look { "Antlion.Chest_Bone" 1.0 "Antlion.Head_Bone" 1.0 "Antlion.FangBottomL1_Bone" 0.0 "Antlion.FangBottomR1_Bone" 0.0 "Antlion.FangTopL1_Bone" 0.0 "Antlion.FangTopR1_Bone" 0.0 "Antlion.ArmL1_Bone" 0.0 "Antlion.ArmR1_Bone" 0.0 }

$sequence headturn "headturn_poses" fps 30
$animation head_neutral headturn_poses frame 0 0 weightlist head_look
$animation head_up headturn_poses frame 1 1 subtract head_neutral 0 weightlist head_look
$animation head_down headturn_poses frame 2 2 subtract head_neutral 0 weightlist head_look
$animation head_right headturn_poses frame 3 3 subtract head_neutral 0 weightlist head_look
$animation head_left headturn_poses frame 4 4 subtract head_neutral 0 weightlist head_look

$sequence head_pitch { head_up head_down blend "head_pitch" -40 40 } delta autoplay
$sequence head_yaw { head_right head_left blend "head_yaw" -40 40 } delta autoplay

$sequence spit 	"distract01"	FPS 60 frames 0 48 activity ACT_RANGE_ATTACK1 1 { event AE_ANTLION_WORKER_SPIT 35 }

