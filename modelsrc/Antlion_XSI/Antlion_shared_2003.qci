//$animblocksize 32

//Base Idle
$cmdlist lockfeet {
/* FIXME: IK disabled until bugs corrected - jdw
	ikrule ltftfoot footstep
	ikrule rtftfoot footstep
	ikrule ltbkfoot footstep
	ikrule rtbkfoot footstep
*/
}

//Idles
$sequence Idle		"DistractIdle01"	loop FPS 30 activity ACT_IDLE 1 cmdlist lockfeet
$sequence DistractIdle2		"DistractIdle02"	loop FPS 30 activity ACT_IDLE 1 cmdlist lockfeet
$sequence DistractIdle3		"DistractIdle03"	loop FPS 30 activity ACT_IDLE 1 cmdlist lockfeet
$sequence DistractIdle4		"DistractIdle04"	loop FPS 30 activity ACT_IDLE 1 cmdlist lockfeet

//$sequence Idle			"Idle01"		loop FPS 30 activity ACT_IDLE 5 cmdlist lockfeet

//Movement

$cmdlist walkik {
/* FIXME: IK disabled until bugs corrected - jdw
	alignto idle
	ikrule ltftfoot footstep range .. 11  1 ..
	ikrule rtftfoot footstep range ..  1 11 ..
	ikrule ltbkfoot footstep range ..  0  9 ..
	ikrule rtbkfoot footstep range ..  9 19 ..
*/
}

$animation a_WalkS WalkS loop LX LY rotateto -180 cmdlist walkik //fps 60
$animation a_WalkSE WalkSE loop LX LY  rotateto -135 cmdlist walkik //fps 60
$animation a_WalkE WalkE loop LX LY rotateto -90 cmdlist walkik
$animation a_WalkNE WalkNE loop LX LY  rotateto -45 cmdlist walkik
$animation a_WalkN WalkN loop LX LY rotateto 0 cmdlist walkik
$animation a_WalkNW WalkNW loop LX LY rotateto 45 cmdlist walkik
$animation a_WalkW WalkW loop LX LY rotateto 90 cmdlist walkik
$animation a_WalkSW WalkSW loop LX LY rotateto 135 cmdlist walkik //fps 60

//$sequence Walk	a_WalkN { event AE_ANTLION_WALK_FOOTSTEP 5 } { event AE_ANTLION_FOOTSTEP_SOFT 10 } { event AE_ANTLION_WALK_FOOTSTEP 15 } { event AE_ANTLION_FOOTSTEP_SOFT 20 } activity ACT_WALK 1

$sequence walk_all {
	a_walkS a_walkSE a_walkE a_walkNE a_walkN a_walkNW a_walkW a_walkSW a_walkS
	blendwidth 9 blend move_yaw -180 180 loop ACT_WALK 1 node "walking"
//	{ event AE_ANTLION_WALK_FOOTSTEP  1 } 
//	{ event AE_ANTLION_FOOTSTEP_SOFT 9 } 
//	{ event AE_ANTLION_WALK_FOOTSTEP  11 } 
//	{ event AE_ANTLION_FOOTSTEP_SOFT 19 }
	{ event 13 5 }
	{ event 12 10 }
	{ event 13 15 }
	{ event 12 20 }

}

$animation a_RunN "Run02" loop FPS 30 LX startloop 8 alignto idle rotateto 0 fixuploop -2 2 {
//	ikrule ltftfoot footstep range .. 4 7 ..
//	ikrule rtftfoot footstep range .. 0 4 ..
//	ikrule ltbkfoot footstep range .. 2 7 ..
//	ikrule rtbkfoot footstep range .. 8 2 ..
}


$animation a_WalkNEfast WalkNE loop LX LY FPS 30 rotateto -45 cmdlist walkik
$animation a_WalkNWfast WalkNW loop LX LY FPS 30 rotateto 45 cmdlist walkik


$animation a_ScuttleRt "ScuttleRt01"	loop FPS 30 LY alignto idle fudgeloop rotateto -90 startloop 7 {
//	ikrule ltftfoot footstep range .. 8 1 ..
//	ikrule rtftfoot footstep range .. 1 10 ..
//	ikrule ltbkfoot footstep range .. 12 6 ..
//	ikrule rtbkfoot footstep range .. 10 4 ..
}

$animation a_ScuttleLeft "ScuttleLeft01" loop FPS 30 LY alignto idle fudgeloop rotateto 90 startloop 11 {
//	ikrule ltftfoot footstep range .. 8 2 ..
//	ikrule rtftfoot footstep range .. 0 9 ..
//	ikrule ltbkfoot footstep range .. 3 12 ..
//	ikrule rtbkfoot footstep range .. 10 4 ..
}

/*
$sequence Run a_RunN activity ACT_RUN 1 {
{ event 13 0 }
{ event 12 2 }
{ event 13 4 }
{ event 12 8 }
}
*/

$sequence run_all {
	a_walkS a_walkSE a_ScuttleRt a_walkNEfast a_RunN a_walkNWfast a_ScuttleLeft a_walkSW a_walkS
	blendwidth 9 blend move_yaw -180 180 ACT_RUN 1 node "walking"
//	{ event AE_ANTLION_WALK_FOOTSTEP  1 } 
//	{ event AE_ANTLION_FOOTSTEP_SOFT 9 } 
//	{ event AE_ANTLION_WALK_FOOTSTEP  11 } 
//	{ event AE_ANTLION_FOOTSTEP_SOFT 19 }
	{ event 13 3 }
	{ event 12 4 }
	{ event 13 7 }
	{ event 12 10 }
}

$sequence ScuttleRt a_ScuttleRt	{ event 13 5 } { event 12 7 } { event 13 12 } { event 12 14 } activity ACT_ANTLION_SIDESTEP_RIGHT 1
$sequence ScuttleLeft a_ScuttleLeft { event 13 5 } { event 12 7 } { event 13 12 } { event 12 14 } activity ACT_ANTLION_SIDESTEP_LEFT 1

$sequence RunAgitated		"bugbaitrun01"		loop FPS 30 LX alignto idle ACT_ANTLION_RUN_AGITATED 1

//Flip over
$sequence Flip1			"flip01"		FPS 30 activity ACT_ANTLION_FLIP 1
//$sequence ZapFlip		"ZapFlip"		FPS 30 activity ACT_ANTLION_ZAP_FLIP 1

//Attacks
$sequence attack1		"attack_01"		FPS 30 { event 24 0 } { event 15 19 } activity ACT_MELEE_ATTACK1 1
$sequence attack2		"attack03"		FPS 30 { event 25 0 } { event 15 17 } activity ACT_MELEE_ATTACK1 1
$sequence attack3		"attackleft02"		FPS 30 { event 24 0 } { event 15 16 } activity ACT_MELEE_ATTACK1 1
$sequence attack4		"attackleftstab01"	FPS 30 { event 24 0 } { event 15 16 } activity ACT_MELEE_ATTACK1 1
$sequence attack5		"attack_fwd01"		FPS 30 lx ly { event 24 0 } { event 15 16 } activity ACT_MELEE_ATTACK1 1
$sequence attack6		"attackfwd03"		FPS 30 lx ly { event 24 0 } { event 15 16 } activity ACT_MELEE_ATTACK1 1

//Attack Transitions
//$sequence attackin		"attackinout"		FPS 30 frame 1 10 activity ACT_ANTLION_ATTACK_IN 1
//$sequence attackout		"attackinout"		FPS 30 frame 35 60 activity ACT_ANTLION_ATTACK_OUT 1

//Charge
$sequence charge_start		"charge02"		X FPS 30 frame 1 21 { event 26 0 } { event 14 18 } { event 14 20 } activity ACT_ANTLION_CHARGE_IN 1

$animation a_charge_run		"charge02"		LX loop FPS 30 frame 22 31 alignto charge_start {
//	ikrule ltftfoot footstep range .. 2 8 ..
//	ikrule rtftfoot footstep range .. 8 4 ..
//	ikrule ltbkfoot footstep range .. 0 4 ..
//	ikrule rtbkfoot footstep range .. 7 2 ..
}

$sequence charge_run		a_charge_run { event 14 1 } { event 14 3 } { event 14 7 } { event 14 9 } activity ACT_ANTLION_CHARGE_LOOP 1

$sequence charge_end		"charge02"		X FPS 30 frame 32 61 alignto charge_run { event 17 9 } { event 14 1 } { event 14 3 } { event 14 4 } { event 14 19 } activity ACT_ANTLION_CHARGE_OUT 1

//Pain
//$sequence hit01			"hit01"			FPS 60 //activity ACT_SMALL_FLINCH 1

//Misc
$sequence pounce		"pounce01"		FPS 30 activity ACT_ANTLION_POUNCE 1 alignto idle {
//	walkframe 8
//	walkframe 13 LX 
//	walkframe 22 LX
//	walkalignto 31 idle LX
	LX
	{ event 17 18 }
}

