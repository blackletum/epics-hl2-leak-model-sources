// Jumping 
$sequence jump_start	"lowfly01"		FPS 30 frame 14 33 activity ACT_JUMP 1 alignto idle { event 22 0 } X Z
$sequence jump_glide	"lowfly01"		origin 0 0 16 loop FPS 30 frame 34 50 activity ACT_GLIDE 1 alignto idle X Z
$sequence jump_stop		"lowfly01"		FPS 30 frame 123 144 activity ACT_LAND 1 alignto idle { event 23 10 } X Z

$sequence fly_in		"lowfly01"		X Z FPS 30 frame 0 33 activity ACT_ANTLION_JUMP_START 1 { event 18 17 } { event 22 17 }

//Turns
$sequence turn_right	"ScuttleRt01"		loop X Y FPS 30 activity ACT_TURN_RIGHT 1
$sequence turn_left		"ScuttleLeft01"		loop X Y FPS 30 activity ACT_TURN_LEFT 1

//Burrowings
$sequence digin			"digin01"			X FPS 60 activity ACT_ANTLION_BURROW_IN 1 { event 19 22 } { event 21 60 }
//$sequence digout1		"digout01"		FPS 30 frame 21 68 activity ACT_ANTLION_BURROW_OUT 1 { event 22 17 }

$sequence digout "holeout" fps 30 activity ACT_ANTLION_BURROW_OUT 1 alignto idle {
walkframe 24 LX LY
walkframe 38 LX LY
{ event 20 1 }
}

