$sequence smashfall64 "smashfall64_A" FPS 30 { event 2002 10 } { event 2002 27 } { event 2002 37 } { event 21 75 }
$sequence slump_a "slump_A"  loop FPS 30
$sequence slumprise_a "slumprise_A" frames 0 127 FPS 30 {
	//{ event AE_NPC_LEFTFOOT 15 } 
	//{ event AE_NPC_RIGHTFOOT 50 } 
	{ event 2050 6 }
	{ event 2051 50 }
	{ event 21 80 }
	{ event 21 100 }
	//alignto slump_a 
	//walkframe 68
	walkalignto 127 idle01 LX LY
}

