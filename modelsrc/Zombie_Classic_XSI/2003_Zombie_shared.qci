$sequence swatleftmid  "Zombie_swatleftmid" FPS 30 alignto idle01 rotate 180 activity ACT_ZOM_SWATLEFTMID 1 {
	{ event 11 1 }
	{ event 10 9 } 
	//cmdlist lockfeet
}

$sequence swatrightmid  "Zombie_swatrightmid" FPS 30 alignto idle01 activity ACT_ZOM_SWATRIGHTMID 1 {
	{ event 11 1 }
	{ event 10 9 } 
	//cmdlist lockfeet
}

$sequence swatleftlow  "Zombie_SwatLeftLow" FPS 30 rotate 180 alignto idle01 lx ly activity ACT_ZOM_SWATLEFTLOW 1 {
	{ event 11 15 }
	{ event 10 15 } 
	//ikrule lfoot footstep range 0 0 17 ..
	//ikrule lfoot footstep range .. 26 45 45
	//ikrule rfoot footstep range 0 0 17 ..
	//ikrule rfoot footstep range .. 39 45 45
}


$sequence swatrightlow  "Zombie_SwatRightLow" FPS 30 alignto idle01 lx ly activity ACT_ZOM_SWATRIGHTLOW 1 {
	{ event 11 1 }
	{ event 10 18 } 
	//ikrule lfoot footstep range 0 0 15 ..
	//ikrule lfoot footstep range .. 38 47 47
	//ikrule rfoot footstep range 0 0 23 ..
	//ikrule rfoot footstep range .. 29 47 47
