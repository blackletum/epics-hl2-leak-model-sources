	//ikrule lfoot footstep range .. 7  16 ..
	//ikrule rfoot footstep range .. 15  4 ..
}
$animation a_Crouch_walkNE Crouch_walkNE frames 0 22 startloop 7 LX LY alignto Idle1 rotateto -45 {
	//ikrule lfoot footstep range .. 7  16 ..
	//ikrule rfoot footstep range .. 17  3 ..
}
$animation a_Crouch_walkN Crouch_walkN startloop 6 LX LY alignto Idle1 rotateto 0 {
	//ikrule lfoot footstep range .. 5  15 ..
	//ikrule rfoot footstep range .. 19  3 ..
}
$animation a_Crouch_walkNW Crouch_walkNW frames 0 22 startloop 16 LX LY alignto idle1 rotateto 45 {
	//ikrule lfoot footstep range .. 7  15 ..
	//ikrule rfoot footstep range .. 19  6 ..
}
$animation a_Crouch_walkW Crouch_walkW startloop 13 LX LY alignto Idle1 rotateto 90 {
	//ikrule lfoot footstep range .. 7  15 ..
	//ikrule rfoot footstep range .. 16  6 ..
}
$animation a_Crouch_walkSW Crouch_walkSW startloop 11 LX LY alignto Idle1 rotateto 135 {
	//ikrule lfoot footstep range .. 7  15 ..
	//ikrule rfoot footstep range .. 16  6 ..
}
*/

$animation a_Crouch_runN Crouch_runN startloop 0 loop LX
$animation a_Crouch_walkS Crouch_walkS frames 0 20 startloop 11 LX LY alignto Idle1 rotateto -180
$animation a_Crouch_walkSE Crouch_walkSE startloop 2 LX LY alignto Idle1 rotateto -135
$animation a_Crouch_walkE Crouch_walkE startloop 5 LX LY alignto Idle1 rotateto -90
$animation a_Crouch_walkNE Crouch_walkNE frames 0 22 startloop 7 LX LY alignto Idle1 rotateto -45
$animation a_Crouch_walkN Crouch_walkN startloop 6 LX LY alignto Idle1 rotateto 0
$animation a_Crouch_walkNW Crouch_walkNW frames 0 22 startloop 16 LX LY alignto idle1 rotateto 45
$animation a_Crouch_walkW Crouch_walkW startloop 13 LX LY alignto Idle1 rotateto 90 
$animation a_Crouch_walkSW Crouch_walkSW startloop 11 LX LY alignto Idle1 rotateto 135

$sequence Crouch_RunALL {
	a_Crouch_walkS a_Crouch_walkSE a_Crouch_walkE
	a_Crouch_walkNE a_Crouch_RunN a_Crouch_walkNW 
	a_Crouch_walkW a_Crouch_walkSW a_Crouch_walkS
	blendwidth 9 blend move_yaw -180 180
	ACT_RUN_CROUCH_RIFLE 1
}

$sequence Crouch_WalkALL {
	a_Crouch_walkS a_Crouch_walkSE a_Crouch_walkE
	a_Crouch_walkNE a_Crouch_walkN a_Crouch_walkNW 
	a_Crouch_walkW a_Crouch_walkSW a_Crouch_walkS
	blendwidth 9 blend move_yaw -180 180
	ACT_WALK_CROUCH_RIFLE 1
}

