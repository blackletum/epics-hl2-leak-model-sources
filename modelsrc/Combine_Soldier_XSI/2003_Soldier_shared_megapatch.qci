$sequence RunALL {
	a_RunS a_RunSE a_RunE
	a_RunNE a_RunN a_RunNW
	a_RunW a_RunSW a_RunS
	blendwidth 9 blend move_yaw -180 180
	ACT_RUN_RIFLE 1
//	{ event 6004 7 "NPC_CombineS" }
//	{ event 6005 16 "NPC_CombineS" }
	loop
}

$sequence RunAIMALL1 {
	a_RunS a_RunSE a_RunE
	a_RunNE a_RunN a_RunNW
	a_RunW a_RunSW a_RunS
	blendwidth 9 blend move_yaw -180 180
	//addlayer layer_run_aiming
	addlayer aim_run_all_delta
	addlayer Aim_all
	ACT_RUN_AIM_RIFLE 1
