$sequence kick "Kick" FPS 36 ACT_MELEE_ATTACK1 1 { event 3 15 }
//$sequence melee_gunhit "melee_gunhit" FPS 30 ACT_MELEE_ATTACK1 1 { event 3 13 } cmdlist lockfeet
//$sequence rappelloop "Rappel_loop" fps 30 loop activity ACT_RAPPEL_LOOP 1

/*
$sequence shootSMG1s "Shoot_SMG1" FPS 30 ACT_RANGE_ATTACK_SMG1 1  { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
$sequence shootSMG1c "Shoot_SMG1_crouch" FPS 30 ACT_RANGE_ATTACK_SMG1_LOW 1  { event 4 0 } addlayer Aim_crouch_delta_all cmdlist lockfeetandlefthand

$sequence shootAR2s "Shoot_AR2" FPS 30 ACT_RANGE_ATTACK_AR2 1  { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
$sequence shootAR2c "Shoot_AR2_crouch" FPS 30 ACT_RANGE_ATTACK_AR2_LOW 1  { event 4 0 } addlayer Aim_crouch_delta_all   cmdlist lockfeetandlefthand
$sequence shootAR2g "Shoot_AR2grenade" FPS 6 ACT_RANGE_ATTACK_AR2_GRENADE 1  { event 4 0 } cmdlist lockfeetandlefthand
$sequence shootAR2alt "shoot_i-rifle_secondary" FPS 30 ACT_COMBINE_AR2_ALTFIRE 1 { event COMBINE_AE_BEGIN_ALTFIRE 0 } { event COMBINE_AE_ALTFIRE 16 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand

$sequence shootSGs "Shoot_SG" FPS 30 ACT_RANGE_ATTACK_SHOTGUN 1 { event 4 0 } addlayer Aim_stand_delta_all_SG cmdlist lockfeet
$sequence shootSGc "Shoot_SG_crouch" FPS 30 ACT_RANGE_ATTACK_SHOTGUN_LOW 1 { event 4 0 } addlayer Aim_crouch_delta_all cmdlist lockfeet
*/

$sequence shootSMG1s "2003_anims/Shoot_AR2" FPS 30 ACT_COMBINE_STANDING_SMG1 1  { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
$sequence shootSMG1c "2003_anims/Shoot_AR2_crouch" FPS 30 ACT_COMBINE_CROUCHING_SMG1 1  { event 4 0 } addlayer Aim_crouch_delta_all cmdlist lockfeetandlefthand

$sequence shootAR2s "2003_anims/Shoot_AR2" FPS 30 ACT_COMBINE_STANDING_AR2 1  { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
$sequence shootAR2c "2003_anims/Shoot_AR2_crouch" FPS 30 ACT_COMBINE_CROUCHING_AR2 1  { event 4 0 } addlayer Aim_crouch_delta_all   cmdlist lockfeetandlefthand
$sequence shootAR2g "Shoot_AR2grenade" FPS 6 ACT_RANGE_ATTACK_AR2_GRENADE 1  { event 4 0 } cmdlist lockfeetandlefthand

$sequence shootSGs "2003_anims/Shoot_AR2" FPS 2.2 ACT_COMBINE_STANDING_SHOTGUN 1 { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeet
$sequence shootSGc "2003_anims/Shoot_AR2_crouch" FPS 2.2 ACT_COMBINE_CROUCHING_SHOTGUN 1 { event 4 0 } addlayer Aim_crouch_delta_all cmdlist lockfeet

$sequence signal_advance "2003_anims/Signal_advance" fps 48 ACT_SIGNAL_ADVANCE 1 cmdlist lockfeet
$sequence signal_forward "2003_anims/Signal_forward" fps 48 ACT_SIGNAL_FORWARD 1 cmdlist lockfeet
$sequence signal_group "2003_anims/Signal_group" fps 48 ACT_SIGNAL_GROUP 1 cmdlist lockfeet
$sequence signal_halt "2003_anims/Signal_halt" fps 48 ACT_SIGNAL_HALT 1 cmdlist lockfeet
$sequence signal_left "2003_anims/Signal_left" fps 48 ACT_SIGNAL_LEFT 1 cmdlist lockfeet
$sequence signal_right "2003_anims/Signal_right" fps 48 ACT_SIGNAL_RIGHT 1 cmdlist lockfeet
$sequence signal_takecover "2003_anims/Signal_takecover" fps 48 ACT_SIGNAL_TAKECOVER 1 cmdlist lockfeet

//$sequence Crouch "Combat_stand_to_crouch" loop FPS 30 ACT_CROUCH 1

$sequence Combat_leanwall_idle01 Combat_leanwall_idle01
$sequence Combat_leanwall_peekleft Combat_leanwall_peekleft
$sequence Combat_leanwall_peekright Combat_leanwall_peekright

// FIXME: not used
$sequence Combat_stand_to_crouch 2003_anims/Combat_stand_to_crouch
$sequence Combat_stand_to_run Combat_stand_to_run LX
$sequence Aim_9_directions 2003_anims/Aim_9_directions


$sequence AR2_reference AR2_reference
$sequence Shoot_AR2_up Shoot_AR2_up
$sequence Shoot_AR2_crouch_up Shoot_AR2_crouch_up
$sequence Crouch_aim_9_directions 2003_anims/Crouch_aim_9_directions
$sequence Crouch_leanwall_idle01 Crouch_leanwall_idle01
$sequence Crouch_leanwall_shoot_left Crouch_leanwall_shoot_left
$sequence Crouch_leanwall_shoot_right Crouch_leanwall_shoot_right
$sequence Crouch_peek_up Crouch_peek_up
$sequence Crouch_to_combat_stand 2003_anims/Crouch_to_combat_stand LX
$sequence Crouch_to_run Crouch_to_run LX

// Aiming, shooting blends

$weightlist upperbody "Valvebiped.bip01_spine" 1.0
$weightlist nolowerbody "Valvebiped.bip01_Pelvis" 1.0 "ValveBiped.Bip01_L_Thigh" 0.0 "ValveBiped.Bip01_R_Thigh" 0.0 
$weightlist pelvisonly "Valvebiped.bip01_Pelvis" 1.0 "Valvebiped.bip01_Spine" 0.0 "ValveBiped.Bip01_L_Thigh" 0.0 "ValveBiped.Bip01_R_Thigh" 0.0 


//**standard aimblend elements, AR2, SMG1
$animation a_aim_stand_neutral 2003_anims/Aim_9_directions frame 4 4
$animation a_aim_stand_down_left 2003_anims/Aim_9_directions frame 0 0 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_down_center 2003_anims/Aim_9_directions frame 1 1 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_down_right 2003_anims/Aim_9_directions frame 2 2 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_mid_left 2003_anims/Aim_9_directions frame 3 3 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_mid_center 2003_anims/Aim_9_directions frame 4 4 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_mid_right 2003_anims/Aim_9_directions frame 5 5 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_up_left 2003_anims/Aim_9_directions frame 6 6 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_up_center 2003_anims/Aim_9_directions frame 7 7 weightlist upperbody subtract a_aim_stand_neutral 0
$animation a_aim_stand_up_right 2003_anims/Aim_9_directions frame 8 8 weightlist upperbody  subtract a_aim_stand_neutral 0
$animation a_aim_stand_straightup Shoot_AR2_up frame 0 0 weightlist upperbody subtract a_aim_stand_neutral 0

/*
//**shotgun aimblend elements
$animation a_aim_stand_neutral_SG Aim_9_directions_SG frame 4 4
$animation a_aim_stand_down_left_SG Aim_9_directions_SG frame 0 0 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_down_center_SG Aim_9_directions_SG frame 1 1 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_down_right_SG Aim_9_directions_SG frame 2 2 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_mid_left_SG Aim_9_directions_SG frame 3 3 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_mid_center_SG Aim_9_directions_SG frame 4 4 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_mid_right_SG Aim_9_directions_SG frame 5 5 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_up_left_SG Aim_9_directions_SG frame 6 6 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_up_center_SG Aim_9_directions_SG frame 7 7 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_up_right_SG Aim_9_directions_SG frame 8 8 subtract a_aim_stand_neutral_SG 0
$animation a_aim_stand_straightup_SG Aim_9_directions_SG frame 9 9 subtract a_aim_stand_neutral_SG 0
*/

//**Crouch aimblend elements
$animation a_aim_crouch_neutral 2003_anims/Crouch_Aim_9_directions frame 1 1
$animation a_aim_crouch_down_left 2003_anims/Crouch_Aim_9_directions frame 0 0 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_down_center 2003_anims/Crouch_Aim_9_directions frame 1 1 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_down_right 2003_anims/Crouch_Aim_9_directions frame 2 2 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_mid_left 2003_anims/Crouch_Aim_9_directions frame 0 0 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_mid_center 2003_anims/Crouch_Aim_9_directions frame 1 1 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_mid_right 2003_anims/Crouch_Aim_9_directions frame 2 2 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_up_left 2003_anims/Crouch_Aim_9_directions frame 3 3 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_up_center 2003_anims/Crouch_Aim_9_directions frame 4 4 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_up_right 2003_anims/Crouch_Aim_9_directions frame 5 5 subtract a_aim_crouch_neutral 0
$animation a_aim_crouch_straightup Shoot_AR2_crouch_up frame 0 0 subtract a_aim_crouch_neutral 0


$sequence Aim_stand_delta_all  {
			a_aim_stand_straightup a_aim_stand_straightup a_aim_stand_straightup
			a_aim_stand_up_right a_aim_stand_up_center a_aim_stand_up_left 
		    a_aim_stand_mid_right a_aim_stand_mid_center a_aim_stand_mid_left 
			a_aim_stand_down_right a_aim_stand_down_center a_aim_stand_down_left 
			//weightlist upperbody
			//blendref a_aim_stand_neutral 
			//blendcenter a_aim_stand_down_center
			blendwidth 3
			blend "aim_yaw" -45 45 blend "aim_pitch" -90 45
			////iklock lfoot 1 0 //iklock rfoot 1 0
			//hidden
			delta 
}

/*
$sequence Aim_stand_delta_all_SG  {
			a_aim_stand_straightup_SG a_aim_stand_straightup_SG a_aim_stand_straightup_SG
			a_aim_stand_up_right_SG a_aim_stand_up_center_SG a_aim_stand_up_left_SG 
		    a_aim_stand_mid_right_SG a_aim_stand_mid_center_SG a_aim_stand_mid_left_SG 
			a_aim_stand_down_right_SG a_aim_stand_down_center_SG a_aim_stand_down_left_SG 
			weightlist nolowerbody
			blendref a_aim_stand_neutral_SG
			blendcomp shootSGs 
			blendcenter a_aim_stand_mid_center_SG
			blendwidth 3 calcblend aim_yaw "anim_attachment_RH" ZR calcblend aim_pitch "anim_attachment_RH" YR
			//iklock lfoot 1 0 //iklock rfoot 1 0
			hidden
			delta }
*/

$sequence Aim_crouch_delta_all  {
			a_aim_crouch_straightup a_aim_crouch_straightup a_aim_crouch_straightup
			a_aim_crouch_up_right a_aim_crouch_up_center a_aim_crouch_up_left 
		  a_aim_crouch_mid_right a_aim_crouch_mid_center a_aim_crouch_mid_left 
//		  a_aim_crouch_down_right a_aim_crouch_down_center a_aim_crouch_down_left
			//blendref a_aim_crouch_neutral 
			//blendcenter a_aim_crouch_mid_center
			blendwidth 3 
			blend "aim_yaw" -45 45 blend "aim_pitch" -90 0
			////iklock lfoot 1 0 //iklock rfoot 1 0
			//hidden 
			delta
}

$sequence Crouch_runN Crouch_runN loop LX

