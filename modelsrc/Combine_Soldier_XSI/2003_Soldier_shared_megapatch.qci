$animation a_RunS 2003_anims/RunS LX LY loop
$animation a_RunSE 2003_anims/RunSE LX LY loop
$animation a_RunE 2003_anims/RunE LX LY loop
$animation a_RunNE 2003_anims/RunNE LX LY loop
$animation a_RunN 2003_anims/RunN LX LY loop
$animation a_RunNW 2003_anims/RunNW LX LY loop
$animation a_RunW 2003_anims/RunW LX LY loop
$animation a_RunSW 2003_anims/RunSW LX LY loop

//Absolute crazy remake of whatever Valve did in 2003 to the run aim animation
$animation aim_run_W weapon_ready_pose_run weightlist pelvisonly subtract a_RunW 0
$animation aim_run_S weapon_ready_pose_run weightlist pelvisonly subtract a_RunS 0
$animation aim_run_E weapon_ready_pose_run weightlist pelvisonly subtract a_RunE 0
$animation aim_run_N weapon_ready_pose_run weightlist pelvisonly subtract a_RunN 0
$animation aim_run_SW weapon_ready_pose_run weightlist pelvisonly subtract a_RunSW 0
$animation aim_run_SE weapon_ready_pose_run weightlist pelvisonly subtract a_RunSE 0
$animation aim_run_NW weapon_ready_pose_run weightlist pelvisonly subtract a_RunNW 0
$animation aim_run_NE weapon_ready_pose_run weightlist pelvisonly subtract a_RunNE 0

$sequence aim_run_all_delta {
	aim_run_S aim_run_SE aim_run_E
	aim_run_NE aim_run_N aim_run_NW
	aim_run_W aim_run_SW aim_run_S
	blendwidth 9 blend move_yaw -180 180
	iklock lfoot 1 0 iklock rfoot 1 0
	delta
}

$animation a_aim_down_left 2003_anims/Aim_9_directions frame 0 0 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_down_center 2003_anims/Aim_9_directions frame 1 1 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_down_right 2003_anims/Aim_9_directions frame 2 2 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_mid_left 2003_anims/Aim_9_directions frame 3 3 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_mid_center 2003_anims/Aim_9_directions frame 4 4 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_mid_right 2003_anims/Aim_9_directions frame 5 5 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_up_left 2003_anims/Aim_9_directions frame 6 6 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_up_center 2003_anims/Aim_9_directions frame 7 7 weightlist upperbody //subtract a_aim_stand_neutral 0
$animation a_aim_up_right 2003_anims/Aim_9_directions frame 8 8 weightlist upperbody  //subtract a_aim_stand_neutral 0
$animation a_aim_straightup Shoot_AR2_up frame 0 0 weightlist upperbody //subtract a_aim_stand_neutral 0

$sequence Aim_all  { 
	a_aim_up_right a_aim_up_center a_aim_up_left 
	a_aim_mid_right a_aim_mid_center a_aim_mid_left 
	a_aim_down_right a_aim_down_center a_aim_down_left 
	weightlist upperbody
	//blendref a_aim_stand_neutral blendcenter a_aim_stand_mid_center
	blendwidth 3 blend "aim_yaw" -45 45 blend "aim_pitch" -45 45
	iklock lfoot 1 0 iklock rfoot 1 0
	//delta
}
