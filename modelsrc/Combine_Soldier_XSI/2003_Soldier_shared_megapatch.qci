//2003 Combine soldier animation remake
//Replicates exactly how Combine in 2003 function
//By the one epicplayer

// global animation rules

$poseparameter "move_yaw" -180 180 wrap
$poseparameter "aim_pitch" -90 90 360
$poseparameter "aim_yaw" -90 90 360

//$include "..\humans\weaponmacros.qci"

//LH Attachment initialization
//$weightlist anim_attachment_lh "valvebiped.bip01_pelvis" 0 "ValveBiped.Anim_Attachment_LH" 1
//$sequence LH_attachment_Init "LH_attachment_Init" fps 30 loop hidden

// Idle

$sequence Idle1	"Idle01" loop FPS 30 ACT_IDLE 1 cmdlist lockfeetandlefthand 
$sequence Idle2	"Idle02" loop FPS 30 ACT_IDLE 1 cmdlist lockfeetandlefthand 
//$sequence Idle1_SMG1 @Idle1 ACT_IDLE_SMG1 1

// combat animations

$sequence crouch_aim_ar2 "2003_anims/crouch_aim_ar2" loop addlayer Aim_stand_delta_all fps 18 activity ACT_RANGE_AIM_AR2_LOW 1

$sequence CombatIdle1 "2003_anims/combat_idle01" loop FPS 30 ACT_IDLE_ANGRY 1 { event 4 0 } addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
//$sequence CombatIdle1_SG "Combat_idle01_SG" loop FPS 30 activity ACT_IDLE_ANGRY_SHOTGUN 1 { event 4 0 } addlayer Aim_stand_delta_all_SG cmdlist lockfeetandlefthand
//$sequence CombatIdle1_SMG1 hold_smg1 loop { event 4 0 } ACT_IDLE_ANGRY_SMG1 1 addlayer Aim_stand_delta_all cmdlist lockfeetandlefthand
//$sequence hold_ar2 "hold_ar2" fps 30 loop
//$sequence hold_smg1 "hold_smg1" fps 30 loop

$sequence cower "2003_anims/Crouch_idle01" FPS 30 ACT_COWER 1 loop cmdlist lockfeet
$sequence CrouchIdle "2003_anims/Crouch_idle01" loop FPS 30 ACT_CROUCHIDLE 1 { event 4 0 } addlayer Aim_crouch_delta_all cmdlist lockfeetandlefthand

//$sequence crouch_aim_ar2 @CrouchIdle loop addlayer Aim_crouch_delta_all fps 18 activity ACT_RANGE_AIM_AR2_LOW 1
//$sequence crouch_aim_sm1 "Crouch_idle01_SMG1" loop addlayer Aim_crouch_delta_all fps 18 cmdlist lockfeetandlefthand activity ACT_RANGE_AIM_SMG1_LOW 1

  
//===================== FLINCHES  ===================================

//Tragically we don't have the original smd to this - epicplayer

$animation "a_flinch_gesture_corrective_animation" "2003_anims\a_flinch_gesture_corrective_animation.smd" {
}

$animation "a_flinch_gesture" "2003_anims\a_flinch_gesture.smd" {
	fps 60
	subtract "a_flinch_gesture_corrective_animation" 0
}

$sequence flinch_gesture a_flinch_gesture ACT_GESTURE_SMALL_FLINCH 1 delta

/*
$sequence flinchhead "Flinch_big_head" FPS 35 ACT_FLINCH_HEAD 1 cmdlist lockfeet
$sequence flinchchest "Flinch_big_chest" FPS 35 ACT_FLINCH_CHEST 1 cmdlist lockfeet
$sequence flinchgut "Flinch_big_gut" FPS 35 ACT_FLINCH_STOMACH 1 cmdlist lockfeet
$sequence flinchleft "Flinch_big_left" FPS 35 ACT_FLINCH_LEFTARM 1 cmdlist lockfeet
$sequence flinchright "Flinch_big_right" FPS 35 ACT_FLINCH_RIGHTARM 1 cmdlist lockfeet

$sequence flinchbig "Flinch_big" FPS 35 ACT_BIG_FLINCH 1 cmdlist lockfeet
$sequence flinchsmall "Flinch_small" FPS 35 ACT_SMALL_FLINCH 1 cmdlist lockfeet

$animation a_flinch_gesture "Flinch" subtract a_flinch_gesture 10
$sequence flinch_gesture a_flinch_gesture delta FPS 60 ACT_GESTURE_SMALL_FLINCH 1

$animation a_flinch_head_gesture "Flinch_head_gest" subtract a_flinch_head_gesture 10
$sequence flinchheadgest a_flinch_head_gesture delta FPS 35 ACT_GESTURE_FLINCH_HEAD 1

$animation a_flinch_gut_gesture "Flinch_gut_gest" subtract a_flinch_gut_gesture 10
$sequence flinchgutgest a_flinch_gut_gesture delta FPS 35 ACT_GESTURE_FLINCH_STOMACH 1

$animation a_flinch_larm_gesture "Flinch_larm_gest" subtract a_flinch_larm_gesture 10
$sequence flinchlarmgest a_flinch_larm_gesture delta FPS 35 ACT_GESTURE_FLINCH_LEFTARM 1

$animation a_flinch_rarm_gesture "Flinch_rarm_gest" subtract a_flinch_rarm_gesture 10
$sequence flinchrarmgest a_flinch_rarm_gesture delta FPS 35 ACT_GESTURE_FLINCH_RIGHTARM 1

//==================== DEATH POSES ========================================
$sequence deathpose_front "death_poses_front" fps 1 frame 0 6 activity ACT_DIE_FRONTSIDE 1
$sequence deathpose_back "death_poses_back" fps 1 frame 0 6 activity ACT_DIE_BACKSIDE 1
$sequence deathpose_right "death_poses_right" fps 1 frame 0 6 activity ACT_DIE_RIGHTSIDE 1
$sequence deathpose_left "death_poses_left" fps 1 frame 0 6 activity ACT_DIE_LEFTSIDE 1

//====================================================================

$sequence bugbait_hit "Bugbait_hit" FPS 30 ACT_COMBINE_BUGBAIT 1
*/

$sequence cover_crouch @CrouchIdle FPS 30 ACT_COVER  1 addlayer Aim_crouch_delta_all
$sequence cover_crouch_low @CrouchIdle FPS 30 ACT_COVER_LOW  1 addlayer Aim_crouch_delta_all 
$sequence cover_crouch_med @CrouchIdle FPS 30 ACT_COVER_MED  1 addlayer Aim_crouch_delta_all

$sequence grenThrow "2003_anims/Grenade_throw" fps 45 ACT_COMBINE_THROW_GRENADE 1 { event 7 30 } cmdlist lockfeet
$sequence grenDrop "2003_anims/Grenade_roll" fps 30 ACT_SPECIAL_ATTACK1 1 { event 9 2 } cmdlist lockfeet
//$sequence grenPlace "Grenade_place" fps 35 ACT_SPECIAL_ATTACK2 1 { event 9 25 } cmdlist lockfeet

$sequence reload_low "2003_anims/Reload_crouching"	FPS 30 ACT_RELOAD_LOW 1 { event 2 30 } cmdlist lockfeet
$sequence reload "2003_anims/Reload_standing" FPS 30 ACT_RELOAD 1 { event 2 28 } cmdlist lockfeet

