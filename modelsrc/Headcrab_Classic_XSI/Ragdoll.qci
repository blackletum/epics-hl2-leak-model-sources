
$collisionjoints ragdoll {

	$mass 5
	$inertia 5.00
	$damping 0.01
	$rotdamping 1.50
	$noselfcollisions
	//$rootbone "bip01 spine"

	$jointconstrain "HeadcrabClassic.ThighR_Bone" x limit -30.00 19.00
	$jointconstrain "HeadcrabClassic.ThighR_Bone" y limit -39.00 47.00
	$jointconstrain "HeadcrabClassic.ThighR_Bone" z limit -44.00 46.00

	$jointconstrain "HeadcrabClassic.ThighL_Bone" x limit -37.00 12.00
	$jointconstrain "HeadcrabClassic.ThighL_Bone" y limit -39.00 46.00
	$jointconstrain "HeadcrabClassic.ThighL_Bone" z limit -44.00 46.00

	$jointconstrain "HeadcrabClassic.CalfL_Bone" z limit -95.00 57.00

	$jointconstrain "HeadcrabClassic.UpperArmR_Bone" x limit -37.00 64.00
	$jointconstrain "HeadcrabClassic.UpperArmR_Bone" y limit -53.00 23.00
	$jointconstrain "HeadcrabClassic.UpperArmR_Bone" z limit -61.00 55.00

	$jointconstrain "HeadcrabClassic.ForeArmR_Bone" z limit -84.00 39.00

	$jointconstrain "HeadcrabClassic.UpperArmL_Bone" x limit -64.00 35.00
	$jointconstrain "HeadcrabClassic.UpperArmL_Bone" y limit -23.00 39.00
	$jointconstrain "HeadcrabClassic.UpperArmL_Bone" z limit -44.00 53.00

	$jointconstrain "HeadcrabClassic.ForeArmL_Bone" z limit -70.00 48.00

	$jointconstrain "HeadcrabClassic.CalfR_Bone" z limit -77.00 57.00
}
$sequence ragdoll 		"ragdoll_pose" 		FPS 30 		activity ACT_DIERAGDOLL 1


$surfaceprop "flesh"
