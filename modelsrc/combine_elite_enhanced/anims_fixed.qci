//$poseparameter "aim_pitch" -90 90 loop 360
//$poseparameter "aim_yaw" -90 90 loop 360

$controller 0 "Bip01 Head" XR -60 60

$weightlist upperbody "Bip01 Spine" 1.0 "Bip01 L Thigh" 0.0 "Bip01 R Thigh" 0.0

$sequence dle "CE_idle1" loop FPS 30
$sequence dleAngry "CE_combatidle" loop FPS 50
$sequence Glide "CE_idle1" loop FPS 30 ACT_GLIDE 1
$sequence Crouch "CE_stand2crouch" FPS 50 ACT_CROUCH 1
$sequence Cower "CE_crouchidle" loop FPS 30 ACT_COWER 1
$sequence Signal "CE_idle1" loop FPS 30 ACT_SIGNAL1 1
$sequence flinch "CE_flinch1" loop FPS 30 ACT_SMALL_FLINCH 1
$sequence walk "WalkN" fps 30 loop LX ACT_WALK 1
$sequence limpwalk "CE_limpwalk" fps 30 loop LX ACT_WALK_HURT 1
$sequence run "CE_run" loop fps 30 LX loop
$sequence limprun "CE_limprun" loop fps 30 LX ACT_RUN_HURT 1

$sequence handsfix_shotgun "a_fixedhands" fps 30 delta subtract dleAngry 0
$sequence handsfix_ar2 "a_fixedhandsar2" fps 30 delta subtract dleAngry 0
$sequence handsfix_smg "a_fixedhandssmg" fps 30 delta subtract dleAngry 0

$sequence runfix_shotgun "a_fixedrunshotgun" fps 30 delta subtract run 0
$sequence runfix_ar2 "a_fixedrunar2" fps 30 delta subtract run 0
$sequence runfix_smg "a_fixedrunsmg" fps 30 delta subtract run 0

$sequence Idle_shotgun "CE_idle1" loop FPS 30 addlayer handsfix_shotgun ACT_IDLE_SHOTGUN 1
$sequence Idle "CE_idle1" loop FPS 30 addlayer handsfix_ar2 ACT_IDLE 1
$sequence Idle_smg1 "CE_idle1" loop FPS 30 addlayer handsfix_smg ACT_IDLE_SMG1 1

$sequence run_shotgun "CE_run_forfixing2" loop fps 30 addlayer runfix_shotgun LX loop ACT_RUN_SHOTGUN 1
$sequence run_ar2 "CE_run_forfixing2" loop fps 30 addlayer runfix_ar2 LX loop ACT_RUN 1
$sequence run_smg "CE_run_forfixing2" loop fps 30 addlayer runfix_smg LX loop ACT_RUN_SMG1 1

$sequence reloadold "CE_reload_normal" fps 30

$animation aim_up "CE_shootcycleup" frame 0 0 subtract reloadold 0
$animation aim_mid "CE_reload_normal" frame 0 0 subtract reloadold 0
$animation aim_down "CE_shootcycledown" frame 0 0 subtract reloadold 0

$sequence shootSMG1s "anims/CE_shootcycleup"		"anims/CE_shootcycledown"   			FPS 30 blend aim_pitch -50 50 ACT_COMBINE_STANDING_SMG1 1 { event 4 0 }
$sequence shootSMG1c "anims/CE_crouchshootcycle(up)" "anims/CE_crouchshootcycle(down)"  FPS 30 blend aim_pitch -50 50	ACT_COMBINE_CROUCHING_SMG1 1 { event 4 0 }

$sequence shootAR2c  "anims/CE_crouchshootcycle(up)" "anims/CE_crouchshootcycle(down)" 	FPS 30 blend aim_pitch -50 50	ACT_COMBINE_CROUCHING_AR2 1  { event 4 0 }
$sequence shootAR2g  "CE_shootcycleup" "CE_shootcycledown" 					FPS 30 blend aim_pitch -50 50	ACT_RANGE_ATTACK_AR2_GRENADE 1  { event 4 0 }

$sequence shootSGs	 "anims/CE_shootcycleup" "anims/CE_shootcycledown" 					FPS 30 blend aim_pitch -50 50	ACT_COMBINE_STANDING_SHOTGUN 1  { event 4 0 }
$sequence shootSGc	 "anims/CE_crouchshootcycle(up)" "anims/CE_crouchshootcycle(down)" 	FPS 30 blend aim_pitch -50 50	ACT_COMBINE_CROUCHING_SHOTGUN 1  { event 4 0 }

$sequence "shootAR2s" {
	"anims/CE_shootcycleup"
	"anims/CE_shootcycledown"
	activity "ACT_COMBINE_STANDING_AR2" 1
	blend "aim_pitch" -50 50
	blendwidth 2
	{ event 4 0 }
}

$sequence "shoot" {
	"anims/CE_shootcycleup"
	"anims/CE_shootcycledown"
	activity "ACT_RANGE_ATTACK1" 1
	blend "aim_pitch" -50 50
	blendwidth 2
	{ event 4 0 }
}

$sequence grenThrow	 "CE_grenadethrow"		fps 30 { event 7 36 }			ACT_COMBINE_THROW_GRENADE 1
$sequence grenLaunch "CE_shoot1"			loop fps 30 { event 8 2 }		ACT_COMBINE_LAUNCH_GRENADE 1
$sequence grenDrop	 "CE_grenadedrop"		loop fps 30 { event 9 2 }		ACT_SPECIAL_ATTACK1 1
$sequence kick		 "anims/CE_sr_attack"	loop fps 30 { event 3 2 }		ACT_MELEE_ATTACK1 1
$sequence die		"CE_dieback"			fps 30							ACT_DIESIMPLE 1
$sequence turnl		"CE_180l"			fps 30								ACT_TURN_LEFT 1
$sequence turnr		"CE_180r"			fps 30								ACT_TURN_RIGHT 1

$sequence reload_med2		"anims/CE_reload_med"	FPS 30					ACT_RELOAD_LOW 1 { event 2 64 }
$sequence reload_med		"anims/CE_reload_med"	FPS 30					ACT_RELOAD_MED 1 { event 2 64 }
$sequence reload			"newreload"				FPS 30					ACT_RELOAD	   1 { event 2 64 }
$sequence cover_crouch_med2  "anims/CE_cover_crouch_med2"	FPS 30			ACT_COVER_LOW  1
$sequence cover_crouch_med  "anims/CE_cover_crouch_med2"	FPS 30			ACT_COVER_MED  1