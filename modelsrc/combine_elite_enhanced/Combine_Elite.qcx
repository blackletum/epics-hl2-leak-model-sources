
$modelname Combine_Elite.mdl

$eyeposition 0 0 73

// head controllers
$controller 0 "Bip01 Head" XR -20 20
//$controller mouth "Line01" ZR 0 45



$body studio "Elite_reference.smd"  {
	eyeball righteye "Bip01 Head" -1.674 -10.541 68.93 "eyeball_r" 1 4 "pupil_r" 0.680
	eyeball lefteye  "Bip01 Head"  1.757 -10.541 68.89 "eyeball_l" 1 -4 "pupil_l" 0.680

	eyelid upper_right "ce_expressions" lowerer 1 -0.221 neutral 0  0.071 raiser 2  0.246 split 0.1 eyeball righteye
	eyelid lower_right "ce_expressions" lowerer 3 -0.331 neutral 0 -0.309 raiser 4 -0.165 split 0.1 eyeball righteye
	eyelid upper_left "ce_expressions" lowerer 1 -0.221 neutral 0  0.071 raiser 2  0.246 split -0.1 eyeball lefteye
	eyelid lower_left "ce_expressions" lowerer 3 -0.331 neutral 0 -0.309 raiser 4 -0.165 split -0.1 eyeball lefteye

	mouth 0 "mouth" "Bip01 Head" 0 -1 0		// mouth illumination

	flexfile "ce_expressions" {
		$include "../Humans/standardflex.qci"
	}

	$include "../Humans/facerules.qci"
}
$body studio "Sniper_reference.smd"

$sequence Idle "CE_idle1" loop FPS 30 ACT_IDLE 1
$sequence IdleAngry "CE_combatidle" loop FPS 50 ACT_IDLE_ANGRY 1
$sequence Glide "CE_idle1" loop FPS 30 ACT_GLIDE 1
$sequence Crouch "CE_stand2crouch" FPS 50 ACT_CROUCH 1
$sequence Cower "CE_crouchidle" loop FPS 30 ACT_COWER 1
$sequence Signal "CE_idle1" loop FPS 30 ACT_SIGNAL1 1
$sequence flinch "CE_flinch1" loop FPS 30 ACT_SMALL_FLINCH 1
$sequence walk "WalkN" fps 30 loop LX ACT_WALK 1
$sequence limpwalk "CE_limpwalk" fps 30 loop LX ACT_WALK_HURT 1
$sequence run "CE_run" loop fps 30 LX loop ACT_RUN 1
$sequence limprun "CE_limprun" loop fps 30 LX ACT_RUN_HURT 1


$sequence shootSMG1s "CE_shootcycleup"		"CE_shootcycledown"   			FPS 30 blend XR -50 50	ACT_COMBINE_STANDING_SMG1 1 { event 4 0 }
$sequence shootSMG1c "CE_crouchshootcycle(up)" "CE_crouchshootcycle(down)"  FPS 30 blend XR -50 50	ACT_COMBINE_CROUCHING_SMG1 1 { event 4 0 }

$sequence shootAR2s	 "CE_shootcycleup"	   "CE_shootcycledown" 				FPS 30 blend XR -50 50	ACT_COMBINE_STANDING_AR2 1  { event 4 0 }
$sequence shootAR2c  "CE_crouchshootcycle(up)" "CE_crouchshootcycle(down)" 	FPS 30 blend XR -50 50	ACT_COMBINE_CROUCHING_AR2 1  { event 4 0 }
$sequence shootAR2g  "CE_shootcycleup" "CE_shootcycledown" 					FPS 30 blend XR -50 50	ACT_RANGE_ATTACK_AR2_GRENADE 1  { event 4 0 }

$sequence shootSGs	 "CE_shootcycleup" "CE_shootcycledown" 					FPS 30 blend XR -50 50	ACT_COMBINE_STANDING_SHOTGUN 1  { event 4 0 }
$sequence shootSGc	 "CE_crouchshootcycle(up)" "CE_crouchshootcycle(down)" 	FPS 30 blend XR -50 50	ACT_COMBINE_CROUCHING_SHOTGUN 1  { event 4 0 }

$sequence grenThrow	 "CE_grenadethrow"	fps 30 { event 7 36 }				ACT_COMBINE_THROW_GRENADE 1
$sequence grenLaunch "CE_shoot1"			loop fps 30 { event 8 2 }		ACT_COMBINE_LAUNCH_GRENADE 1
$sequence grenDrop	 "CE_grenadedrop"	loop fps 30 { event 9 2 }			ACT_SPECIAL_ATTACK1 1
$sequence kick		 "CE_sr_attack"		loop fps 30 { event 3 2 }			ACT_MELEE_ATTACK1 1
$sequence die		"CE_dieback"			fps 30							ACT_DIESIMPLE 1
$sequence turnl		"CE_180l"			fps 30								ACT_TURN_LEFT 1
$sequence turnr		"CE_180r"			fps 30								ACT_TURN_RIGHT 1

$sequence reload_low		"CE_reload_low"			FPS 30					ACT_RELOAD_LOW 1 { event 2 64 }
$sequence reload_med		"CE_reload_med"			FPS 30					ACT_RELOAD_MED 1 { event 2 64 }
$sequence reload			"CE_reload_normal"		FPS 30					ACT_RELOAD	   1 { event 2 64 }
$sequence cover_crouch_low	"CE_cover_crouch_low"	FPS 30					ACT_COVER_LOW  1
$sequence cover_crouch_med  "CE_cover_crouch_med"	FPS 30					ACT_COVER_MED  1

$include "ragdoll.qci"
