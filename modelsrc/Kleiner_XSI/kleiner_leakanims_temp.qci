$animation "a_armpose01A" "kleiner_anims\a_armpose01A.smd" {
	
	loop
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "a_armpose01A_corrective_animation" 0
	ikrule "rhand" release contact 0  floor 0 height 0  range 0 0 5 5
	ikrule "lhand" release contact 0  floor 0 height 0  range 0 0 5 5
	weightlist "weights_body_trans_y"
}

$animation "a_armpose01B" "kleiner_anims\a_armpose01B.smd" {
	
