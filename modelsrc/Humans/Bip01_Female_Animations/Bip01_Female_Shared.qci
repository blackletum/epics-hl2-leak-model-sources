//Shared Citizen Bip01 Animations for different humans.
//By The One Epicplayer

$poseparameter "aim_pitch" -90 90 loop 360


$sequence Idle01 "predator_Idle01.smd" loop FPS 30 activity ACT_IDLE 1 frame 449 500
$sequence sexyidle "predator_Idle01.smd" loop FPS 30 //activity ACT_IDLE 1

