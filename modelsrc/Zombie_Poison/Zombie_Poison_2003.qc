$modelname Zombie/Poison.mdl
//$animblocksize 32
// whole body
$body studio "2003_meshes\Zombie_Poison_Reference.smd"
//$include "hitbox_torso.qc"
//$include "hitbox_legs.qc"
//$include "hitbox_head.qc"
$eyeposition 0 0 64
$cdmaterials models/zombie_poison

//Headcrab 1
$bodygroup headcrab1
{
blank
studio "2003_meshes/Headcrab_1_reference.smd"
}

//Headcrab 2
$bodygroup headcrab2 
{
blank
studio "2003_meshes/Headcrab_2_reference.smd"
}

//Headcrab 3
$bodygroup headcrab3
{
blank
studio "2003_meshes/Headcrab_3_reference.smd"
}

//Headcrab 4 (on hand)
$bodygroup headcrab4
{
blank
studio "2003_meshes/Headcrab_4_reference.smd"
}

//Headcrab 5
$bodygroup headcrab5
{
blank
studio "2003_meshes/Headcrab_5_reference.smd"
}

/*
//Test crab
$bodygroup headcrab6
{
blank
studio "2002_meshes/Headcrab_Reference.smd"
}
*/

/*
$attachment "eyes" "ValveBiped.Bip01_Spine4" 10.00 0.00 0.00 rotate 0 0 -180
$attachment "head" "ValveBiped.Bip01_Spine4" 10.00 0.00 0.00 rotate 0 0 -180
$attachment "chest" "ValveBiped.Bip01_Spine4" -6.00 0.00 4.00 rotate 0 0 0

$attachment "headcrab1" "ValveBiped.Headcrab_Cube1" 0 0 0
$attachment "headcrab2" "ValveBiped.Headcrab_Cube2" 0 0 0
$attachment "headcrab3" "ValveBiped.Headcrab_Cube3" 0 0 0
$attachment "headcrab4" "ValveBiped.Headcrab_Cube4" 0 0 0
$attachment "headcrab5" "ValveBiped.HC5_Bodybox" 0 0 0
$attachment Blood_Left "ValveBiped.Bip01_L_Finger2" 0 0 0 rigid
$attachment Blood_Right "ValveBiped.Bip01_R_Finger2" 0 0 0 rigid

$collapsebones
*/

// .qc block generated by HLMV begins. (HITBOXES EDITED BY STEVE BOND)

$surfaceprop "flesh"

$sequence refpose "zombiepoison_refpose" lx ly fps 30

$sequence Idle01 "zombiepoison_idle" fps 30 loop ACT_IDLE 1

$sequence FireWalk "Firewalk_N" alignto idle01 fps 44 LX loop ACT_ZOM_WALK_ON_FIRE 1 { event 16 40 } { event 17 10 }
$sequence Walk "zombiepoison_walk" alignto idle01 fps 40 LX loop ACT_WALK 1 { event 16 40 } { event 17 10 }
$sequence Run "zombiepoison_Run" alignto idle01 fps 40 LX loop //ACT_RUN 1

$sequence headcrab2Leap "headcrab2_leap" fps 30 ACT_RANGE_ATTACK1 1 { event 61 4 } { event 63 68 }
$sequence Throw "zombiepoison_throw" fps 30 ACT_RANGE_ATTACK2 1 { event 61 23 } { event 62 30 } { event 63 39 }
/*
$sequence melee_01 "melee_01" fps 30 activity ACT_MELEE_ATTACK1 1 { 
	{ event AE_ZOMBIE_ATTACK_SCREAM 5 } 
	{ event AE_ZOMBIE_ATTACK_RIGHT 29 }
	walkframe 24 lx ly
	walkframe 37 lx ly
	walkframe 45 lx ly
}
*/

$sequence spray Spray ACT_MELEE_ATTACK1 1 { event 64 31 }

$sequence releasecrab "Crabrelease" FPS 30 alignto idle01 activity ACT_ZOM_RELEASECRAB 1
$sequence FlinchL "flinch_left" fps 30 activity ACT_SMALL_FLINCH 1
$sequence FlinchR "flinch_right" fps 30 activity ACT_SMALL_FLINCH 1
$sequence FlinchC "flinch_center" fps 30 activity ACT_SMALL_FLINCH 1

$sequence ThrowWarning "flinch_center" fps 10 activity ACT_ZOMBIE_POISON_THREAT 1 { event 60 1 }

//Unused anims found in the modelsrc
$sequence Headcrab_1_backjump Headcrab_1_backjump
$sequence headcrab2_mount headcrab2_mount
$sequence Roar_small Roar_small
$sequence Spit_two_streams Spit_two_streams
$sequence Throw_headcrab_1 Throw_headcrab_1
$sequence Throw_headcrab_2 Throw_headcrab_2
$sequence Throw_headcrab_3 Throw_headcrab_3
$sequence Turn_left Turn_left_90 LZR
$sequence Turn_right Turn_right_90 LZR


$include "ragdoll_2003.qci"
$include "hitbox.qci"

