	$jointconstrain "ValveBiped.Bip01_R_Forearm" z limit -149 4 5

	$jointconstrain "ValveBiped.Bip01_R_Hand" x limit -60 60 5
	$jointconstrain "ValveBiped.Bip01_R_Hand" y limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_R_Hand" z limit -57 70 5

	$jointconstrain "ValveBiped.Bip01_R_Thigh" x limit -12 12 5
