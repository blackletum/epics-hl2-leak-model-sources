	$jointconstrain "ValveBiped.Bip01_R_Thigh" z limit -97 32 5

	$jointconstrain "ValveBiped.Bip01_R_Calf" x limit 0 0 5
	$jointconstrain "ValveBiped.Bip01_R_Calf" y limit 0 0 5
	$jointconstrain "ValveBiped.Bip01_R_Calf" z limit -12 126 5

	$jointconstrain "ValveBiped.Bip01_Head1" x limit -20 20 5
	$jointconstrain "ValveBiped.Bip01_Head1" y limit -25 25 5
	$jointconstrain "ValveBiped.Bip01_Head1" z limit -13 30 5

	$jointconstrain "ValveBiped.Bip01_L_Thigh" x limit -12 12 5
	$jointconstrain "ValveBiped.Bip01_L_Thigh" y limit -73 6 5
	$jointconstrain "ValveBiped.Bip01_L_Thigh" z limit -93 30 5

	$jointconstrain "ValveBiped.Bip01_L_Calf" x limit 0 0 5
	$jointconstrain "ValveBiped.Bip01_L_Calf" y limit 0 0 5
